{
  "manifestVersion": 2,
  "id": "coordinator-board",
  "name": "Coordinator Board",
  "version": "0.2.1",
  "description": "One board for agent sessions across projects: \"My decisions\" cards with suggested replies, work requests for a coordinator agent, progress and usage.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "board",
        "title": "Coordinator Board",
        "icon": "bot",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "coordinator-board.toggle",
        "title": "Coordinator Board: Toggle the right sidebar",
        "when": "global"
      },
      {
        "id": "coordinator-board.digest",
        "title": "Coordinator Board: Request digest",
        "when": "global"
      }
    ],
    "statusBarItems": [
      {
        "id": "decisions",
        "text": "Decisions –",
        "icon": "bell",
        "tooltip": "Coordinator Board",
        "command": "coordinator-board.toggle"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ],
    "settings": [
      {
        "key": "coordPath",
        "title": "coord CLI path",
        "description": "Leave empty to use this repository's cli/coord.mjs, then `coord` on PATH.",
        "type": "string",
        "default": ""
      },
      {
        "key": "notify",
        "title": "Notify on new decisions",
        "description": "Show a desktop notification when a menu, permission prompt or \"now\" card appears.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "language",
        "title": "Status bar and notification language",
        "description": "The panel follows Orca's UI language; this sets the status bar and notifications. Auto uses the board language (coord setup --language).",
        "type": "string",
        "enum": [
          "auto",
          "en",
          "ko"
        ],
        "enumLabels": [
          "Auto",
          "English",
          "한국어"
        ],
        "default": "auto"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "notifications:show"
    }
  ],
  "author": {
    "name": "sayzard",
    "url": "https://github.com/sayzard"
  },
  "repository": "https://github.com/sayzard/orca-coordinator",
  "license": "MIT"
}
